<Defs>

  <!-- Runner Duck -->
  <ThingDef ParentName="EggUnfertBase">
    <defName>EggRunnerDuckUnfertilized</defName>
    <label>duck egg (unfert.)</label>
    <description>An unfertilized duck egg.</description>
    <graphicData>
      <color>(135,155,125)</color>
    </graphicData>
    <statBases>
      <MarketValue>9.0</MarketValue>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="EggFertBase">
    <defName>EggRunnerDuckFertilized</defName>
    <label>duck egg (fert.)</label>
    <description>A fertilized duck egg. If all goes well, it should hatch into a duckling.</description>
    <graphicData>
      <color>(135,155,125)</color>
    </graphicData>
    <statBases>
      <MarketValue>9.0</MarketValue>
    </statBases>
    <comps>
      <li Class="CompProperties_Hatcher">
        <hatcherDaystoHatch>3.5</hatcherDaystoHatch>
        <hatcherPawn>RunnerDuck</hatcherPawn>
      </li>
    </comps>
  </ThingDef>

