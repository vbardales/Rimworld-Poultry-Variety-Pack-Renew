<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- ======================= Duck =============================== -->

  <ThingDef ParentName="AnimalThingBase">
    <defName>MuscovyDuck</defName>
    <label>Muscovy duck</label>
    <description>A large duck with facial wattles. Many feral populations of this breed exist on various planets.</description>
    <statBases>
      <Wildness>0.1</Wildness>
      <MoveSpeed>2.5</MoveSpeed>
      <MarketValue>30</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-8</ComfyTemperatureMin>
      <FilthRate>4</FilthRate>
    </statBases>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>EggMuscovyDuckUnfertilized</eggUnfertilizedDef>
        <eggFertilizedDef>EggMuscovyDuckFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>16</eggFertilizationCountMax>
        <eggLayIntervalDays>15</eggLayIntervalDays>
        <eggCountRange>
          <min>8</min>
          <max>16</max>
	</eggCountRange>
      </li>
    </comps>
    <race>
      <body>Bird</body>
      <baseHungerRate>0.2</baseHungerRate>
      <baseBodySize>0.3</baseBodySize>
      <baseHealthScale>0.4</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <trainability>None</trainability>
      <roamMtbDays>14</roamMtbDays>
      <mateMtbHours>48</mateMtbHours>
	<wildBiomes>
		<TemperateSwamp>0.9</TemperateSwamp>
		<TropicalSwamp>0.9</TropicalSwamp>
		<TemperateForest>0.5</TemperateForest>
		<TropicalRainforest>0.5</TropicalRainforest>
	</wildBiomes>
      <lifeExpectancy>8</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Chick_Call</soundWounded>
          <soundDeath>Pawn_Chick_Call</soundDeath>
          <soundCall>Pawn_Chick_Call</soundCall>
          <soundAngry>Pawn_Chick_Call</soundAngry>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.12</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.2</minAge>
          <soundWounded>Pawn_Duck_Wounded</soundWounded>
          <soundDeath>Pawn_Duck_Death</soundDeath>
          <soundCall>Pawn_Duck_Call</soundCall>
          <soundAngry>Pawn_Duck_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalFarm</li>
    </tradeTags>
    <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>3</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>5</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>2</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>MuscovyDuck</defName>
    <label>Muscovy duck</label>
    <race>MuscovyDuck</race>
    <combatPower>30</combatPower>
    <ecoSystemWeight>0.10</ecoSystemWeight>
    <lifeStages>
      <li>
        <label>duckling</label>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/MuscovyDuckling</texPath>
          <drawSize>0.3</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.3</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/MuscovyDuckling</texPath>
          <drawSize>0.5</drawSize>
        </bodyGraphicData>
        <femaleGraphicData>
          <texPath>Things/Pawn/Animal/MuscovyDuckling</texPath>
          <drawSize>0.5</drawSize>
        </femaleGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.5</drawSize>
        </dessicatedBodyGraphicData>
        <femaleDessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.5</drawSize>
        </femaleDessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/MuscovyDrake</texPath>
          <drawSize>0.9</drawSize>
          <shadowData>
            <volume>(0.3, 0.4, 0.3)</volume>
            <offset>(0,0,-0.05)</offset>
          </shadowData>
        </bodyGraphicData>
        <femaleGraphicData>
          <texPath>Things/Pawn/Animal/MuscovyDuck</texPath>
          <drawSize>0.85</drawSize>
        </femaleGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.9</drawSize>
        </dessicatedBodyGraphicData>
        <femaleDessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.85</drawSize>
        </femaleDessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>



</Defs>
