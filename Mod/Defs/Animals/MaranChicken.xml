<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <ThingDef ParentName="AnimalThingBase">
    <defName>MaranChicken</defName>
    <label>Marans chicken</label>
    <description>A chicken that lays unusually dark eggs.</description>
    <statBases>
      <Wildness>0</Wildness>
      <MoveSpeed>2.1</MoveSpeed>
      <MarketValue>50</MarketValue>
      <LeatherAmount>0</LeatherAmount>
      <ComfyTemperatureMin>-10</ComfyTemperatureMin>
      <FilthRate>4</FilthRate>
    </statBases>
    <comps>
      <li Class="CompProperties_EggLayer">
        <eggUnfertilizedDef>EggMaransUnfertilized</eggUnfertilizedDef>
        <eggFertilizedDef>EggMaransFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>8</eggFertilizationCountMax>
        <eggLayIntervalDays>0.35</eggLayIntervalDays>
        <eggCountRange>1</eggCountRange>
      </li>
    </comps>
    <race>
      <body>Bird</body>
      <baseHungerRate>0.14</baseHungerRate>
      <baseBodySize>0.25</baseBodySize>
      <baseHealthScale>0.35</baseHealthScale>
      <foodType>VegetarianRoughAnimal</foodType>
      <trainability>None</trainability>
      <roamMtbDays>7</roamMtbDays>
      <mateMtbHours>8</mateMtbHours>
      <lifeExpectancy>6</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalBabyTiny</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Chick_Call</soundWounded>
          <soundDeath>Pawn_Chick_Call</soundDeath>
          <soundCall>Pawn_Chick_Call</soundCall>
          <soundAngry>Pawn_Chick_Call</soundAngry>
        </li>
        <li>
          <def>AnimalJuvenile</def>
          <minAge>0.15</minAge>
        </li>
        <li>
          <def>AnimalAdult</def>
          <minAge>0.3</minAge>
          <soundWounded>Pawn_Chicken_Wounded</soundWounded>
          <soundDeath>Pawn_Chicken_Death</soundDeath>
          <soundCall>Pawn_Chicken_Call</soundCall>
          <soundAngry>Pawn_Chicken_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_SmallScratch_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_SmallScratch_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_SmallScratch_Miss</soundMeleeMiss>
    </race>
    <tradeTags>
      <li>AnimalFarm</li>
    </tradeTags>
    <tools>
      <li>
        <label>claws</label>
        <capacities>
          <li>Scratch</li>
        </capacities>
        <power>2</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>Feet</linkedBodyPartsGroup>
      </li>
      <li>
        <label>beak</label>
        <capacities>
          <li>Bite</li>
        </capacities>
        <power>3</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>Beak</linkedBodyPartsGroup>
      </li>
      <li>
        <label>head</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>1</power>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.2</chanceFactor>
      </li>
    </tools>
  </ThingDef>

  <PawnKindDef ParentName="AnimalKindBase">
    <defName>MaranChicken</defName>
    <label>Marans Chicken</label>
    <labelMale>Marans rooster</labelMale>
    <labelFemale>Marans hen</labelFemale>
    <race>MaranChicken</race>
    <combatPower>30</combatPower>
    <ecoSystemWeight>0.20</ecoSystemWeight>

    <!-- Four Marans colours, each with its own chick, rooster and hen texture. The original
         mod went through AnimalVariations.dll and MaranChicken_SkinSet.xml, which vanilla
         cannot reproduce: its alternateGraphics fix a single texPath, applied from chick to
         adult. Weights carried over from the SkinSet as they stood. The order of the four
         entries has to stay the same from one stage to the next: the index is what carries
         the colour as the bird grows. -->
    <modExtensions>
      <li Class="PoultryVarietyPack.SkinSetModExt">
        <lifeStages>
          <li>
            <variants>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlueCopperMaranChick</texPath><weight>0.3</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranChick</texPath><weight>0.4</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BirchenMaranChick</texPath><weight>0.1</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/SilverCuckooMaranChick</texPath><weight>0.3</weight></li>
            </variants>
          </li>
          <li>
            <variants>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlueCopperMaranRooster</texPath><weight>0.3</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranRooster</texPath><weight>0.4</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BirchenMaranRooster</texPath><weight>0.1</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/SilverCuckooMaranRooster</texPath><weight>0.3</weight></li>
            </variants>
            <variantsFemale>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlueCopperMaranHen</texPath><weight>0.3</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranHen</texPath><weight>0.4</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BirchenMaranHen</texPath><weight>0.1</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/SilverCuckooMaranHen</texPath><weight>0.3</weight></li>
            </variantsFemale>
          </li>
          <li>
            <variants>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlueCopperMaranRooster</texPath><weight>0.3</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranRooster</texPath><weight>0.4</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BirchenMaranRooster</texPath><weight>0.1</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/SilverCuckooMaranRooster</texPath><weight>0.3</weight></li>
            </variants>
            <variantsFemale>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlueCopperMaranHen</texPath><weight>0.3</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranHen</texPath><weight>0.4</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/BirchenMaranHen</texPath><weight>0.1</weight></li>
              <li><texPath>Things/Pawn/Animal/MaranChicken/SilverCuckooMaranHen</texPath><weight>0.3</weight></li>
            </variantsFemale>
          </li>
        </lifeStages>
      </li>
    </modExtensions>
    <lifeStages>
      <li>
        <label>Marans chick</label>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranChick</texPath>
          <drawSize>0.3</drawSize>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.3</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <label>Marans chicken</label>
    	<labelMale>Marans cockerel</labelMale>
    	<labelFemale>Marans pullet</labelFemale>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranRooster</texPath>
          <drawSize>0.6</drawSize>
        </bodyGraphicData>
        <femaleGraphicData>
          <texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranHen</texPath>
          <drawSize>0.6</drawSize>
        </femaleGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.6</drawSize>
        </dessicatedBodyGraphicData>
      </li>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranRooster</texPath>
          <drawSize>0.87</drawSize>
        </bodyGraphicData>
        <femaleGraphicData>
          <texPath>Things/Pawn/Animal/MaranChicken/BlackCopperMaranHen</texPath>
          <drawSize>0.85</drawSize>
        </femaleGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.87</drawSize>
        </dessicatedBodyGraphicData>
        <femaleDessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/Chicken/Dessicated_Chicken</texPath>
          <drawSize>0.85</drawSize>
        </femaleDessicatedBodyGraphicData>
      </li>
    </lifeStages>
  </PawnKindDef>

</Defs>
